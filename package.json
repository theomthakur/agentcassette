{
  "name": "agentcassette",
  "version": "0.1.0",
  "description": "Deterministic semantic record and replay for LLM agent tests",
  "keywords": [
    "llm",
    "agent",
    "testing",
    "record-replay",
    "cassette",
    "vitest",
    "jest"
  ],
  "license": "MIT",
  "author": "Theo M. Thakur",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "import": "./dist/vitest.js",
      "require": "./dist/vitest.cjs"
    },
    "./jest": {
      "types": "./dist/jest.d.ts",
      "import": "./dist/jest.js",
      "require": "./dist/jest.cjs"
    }
  },
  "bin": {
    "agentcassette": "dist/cli.cjs"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
